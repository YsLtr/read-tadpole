{
  "name": "@read-tadpole/extension",
  "version": "1.0.0",
  "private": true,
  "description": "ReadTadpole（阅读蝌蚪）: readfrog lite 阅读蛙青春版 — AI bilingual translation and video subtitles",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox",
    "release": "changeset git-tag"
  },
